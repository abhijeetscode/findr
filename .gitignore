# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Environment / secrets
.env

# SQLite database files
*.db
*.db-wal
*.db-shm

# macOS
.DS_Store

# Local upload storage and log files. data/logs/ itself is kept (empty) in
# the repo so Docker never has to create the bind-mounted folder — it would
# create it owned by root (specs/logging-telemetry.md §14).
data/*
!data/logs/
data/logs/*
!data/logs/.gitkeep
