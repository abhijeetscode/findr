# Copy this file to .env and fill in real values. Never commit .env.

FINDR_DATABASE_PATH=findr.db
FINDR_SESSION_SECRET=change-me-to-a-random-secret

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FINDR_TOKEN_ENCRYPTION_KEY=change-me-to-a-fernet-key

FINDR_SYNC_INTERVAL_SECONDS=300

# No public sign-up — the app seeds this single account on startup instead.
# Uncomment to override the published defaults (demouser / password@2050).
#FINDR_DEMO_USERNAME=demouser
#FINDR_DEMO_PASSWORD=password@2050

# From Google Cloud Console > APIs & Services > Credentials
# (see specs/gmail-connector.md, section "Prerequisite: Google Cloud setup")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/sources/gmail/callback

# From api.slack.com/apps > OAuth & Permissions
# (see specs/slack-connector.md, section "Prerequisite: Slack app setup")
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/sources/slack/callback

# From notion.so/my-integrations > your public integration
# (see specs/notion-connector.md, section "Prerequisite: Notion integration setup")
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/sources/notion/callback
