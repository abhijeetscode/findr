# Copy this file to .env and fill in real values. Never commit .env.

# Local dev: `docker compose up -d postgres elasticsearch`
FINDR_DATABASE_URL=postgresql+psycopg://findr:findr@localhost:5432/findr
FINDR_ELASTICSEARCH_URL=http://localhost:9200
FINDR_ELASTICSEARCH_INDEX=findr_documents

FINDR_SESSION_SECRET=change-me-to-a-random-secret

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FINDR_TOKEN_ENCRYPTION_KEY=change-me-to-a-fernet-key

FINDR_SYNC_INTERVAL_SECONDS=300

# Uploaded files' originals (specs/file-upload.md). docker-compose.yml sets
# this to its volume; for `uv run` outside Docker, point it somewhere writable:
#FINDR_UPLOAD_STORAGE_ROOT=./data/uploads

# Queue for background upload processing (specs/upload-chunking.md).
# docker-compose.yml sets this to its redis service.
FINDR_REDIS_URL=redis://localhost:6379/0

# Semantic search (specs/semantic-search.md).
# Local embedding model — downloads (~1.2GB) on first startup. Its output
# dimension must match es_client.EMBEDDING_DIMS (1024); changing models
# means a full reindex.
FINDR_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Max tokens embedded per document; longer text is truncated. Higher values
# embed more of long documents but are much slower on CPU.
FINDR_EMBEDDING_MAX_SEQ_LENGTH=512
# Cosine-similarity floor (0-1) for a semantic-only match to count. Lower
# finds looser paraphrases but lets in more unrelated results.
FINDR_SEMANTIC_MIN_SIMILARITY=0.4

# No public sign-up — the app seeds this single account on startup instead.
# Uncomment to override the published defaults (demouser / password@2050).
#FINDR_DEMO_USERNAME=demouser
#FINDR_DEMO_PASSWORD=password@2050

# From Google Cloud Console > APIs & Services > Credentials
# (see specs/gmail-connector.md, section "Prerequisite: Google Cloud setup")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/sources/gmail/callback
